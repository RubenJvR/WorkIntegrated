<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Database\ADIX.sql" />
    <None Remove="icons\collapse.png" />
    <None Remove="icons\dashboard_icon.png" />
    <None Remove="icons\Finance.png" />
    <None Remove="icons\finance_White.png" />
    <None Remove="icons\inventory_icon.png" />
    <None Remove="icons\inventory_white.png" />
    <None Remove="icons\itemgroup_White.png" />
    <None Remove="icons\loggo.png" />
    <None Remove="icons\monthly-reporting.png" />
    <None Remove="icons\point-of-sale_White.png" />
    <None Remove="icons\point-of-service.png" />
    <None Remove="icons\products.png" />
    <None Remove="icons\products_White.png" />
    <None Remove="icons\Sales.png" />
    <None Remove="icons\sales_2.png" />
    <None Remove="icons\settings.png" />
    <None Remove="icons\Supplier.png" />
    <None Remove="icons\supplier_White.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Database\ADIX.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc6.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="9.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.10" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icons\collapse.png" />
    <Resource Include="icons\dashboard_White.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\dashboard_icon.png" />
    <Resource Include="icons\finance.png" />
    <Resource Include="icons\finance_White.png" />
    <Resource Include="icons\inventory_icon.png" />
    <Resource Include="icons\inventory_white.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\itemgroup_White.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\loggo.png" />
    <Resource Include="icons\monthly-reporting.png" />
    <Resource Include="icons\point-of-sale_White.png">
      <CopyToOutputDirectory></CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\point-of-service.png" />
    <Resource Include="icons\products.png" />
    <Resource Include="icons\products_White.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons\Sales.png" />
    <Resource Include="icons\sales_2.png" />
    <Resource Include="icons\settings.png" />
    <Resource Include="icons\Supplier.png" />
    <Resource Include="icons\supplier_White.png" />
    <Resource Include="Image\loggo.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Components\HorizontalCarousel.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
