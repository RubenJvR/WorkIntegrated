<Page x:Class="ADIX.Qoute"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ADIX"
      Title="Quote">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                           Text="{TemplateBinding Tag}"
                           Foreground="LightGray"
                           Margin="8,0,30,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Press"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded dark CheckBox style -->
        <Style x:Key="RoundedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Border"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   CornerRadius="6"
                   Padding="{TemplateBinding Padding}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Custom tick box -->
                                    <Border x:Name="CheckMarkBorder"
                               Width="16"
                               Height="16"
                               BorderBrush="White"
                               BorderThickness="1"
                               CornerRadius="3"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                                        <Path x:Name="CheckMark"
                                 Data="M 2 8 L 6 12 L 14 2"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Content text -->
                                    <ContentPresenter VerticalAlignment="Center"
                                         RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                   CornerRadius="4" 
                   Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#878787" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Top Info -->
            <RowDefinition Height="*"/>
            <!-- Items -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
            <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Qoute"/>
        </Border>

        <!-- ================= TOP INFO ================= -->
        <Grid Grid.Row="1" Margin="0,10,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10,0,10,0">
                <!-- Logo -->
                <Border  Height="120" VerticalAlignment="Top" HorizontalAlignment="Left" Width="160">
                    <Image Source="/Image/ADIX_LOGO.png"/>

                </Border>

                <Border  Style="{StaticResource InputBorderStyle}">
                    <Grid>
                        <TextBlock Text="Payment"
                    Foreground="LightGray"
                    Margin="8,0,30,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border  Style="{StaticResource InputBorderStyle}">
                    <Grid>
                        <TextBlock Text="Bill to"
                      Foreground="LightGray"
                      Margin="8,0,30,0"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border  Style="{StaticResource InputBorderStyle}">
                    <Grid>
                        <TextBlock Text=""
                            Foreground="LightGray"
                            Margin="8,0,30,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- RIGHT SIDE -->
            <StackPanel Grid.Column="1" Margin="10,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="200,0,0,0">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="Date" Width="150"
                                Foreground="LightGray"
                                Margin="18,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="200,0,0,0">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="INV #" Width="150"
                                Foreground="LightGray"
                                Margin="18,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="200,0,0,0">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="Staff ID" Width="150"
                            Foreground="LightGray"
                            Margin="18,0,30,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border  Style="{StaticResource InputBorderStyle}"  Margin="200,0,0,5" Height="100" Width="200">
                    <Grid>
                        <TextBox x:Name="AddressTextBox"
                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 Padding="5,5,5,5"
                 VerticalContentAlignment="Top"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text=" Address"
                   Foreground="LightGray"
                   Margin="8,5,0,0"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   Visibility="{Binding Text, ElementName=AddressTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Invoice Table -->
        <ScrollViewer Grid.Row="2" Margin="0,10,0,10"
   HorizontalScrollBarVisibility="Auto"
   VerticalScrollBarVisibility="Auto">
            <DataGrid x:Name="ProductsGrid"
   AutoGenerateColumns="False"
   IsReadOnly="False"
   Background="#4F4F4F"
   Foreground="White"
   GridLinesVisibility="All"
   BorderBrush="Black"
   BorderThickness="1"
   HeadersVisibility="Column"
   CanUserAddRows="True"
   RowHeight="35"
   ColumnHeaderHeight="40"
   FontSize="14"
   Height="178"
   SelectionMode="Single"
   SelectionUnit="FullRow">

                <!-- Column Header Styling -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Cell Styling -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <!-- Keep dark theme on selection -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <!-- Columns -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU #" Binding="{Binding ProductID}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding ProductID}" Width="100"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding ProductID}" Width="100"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding ProductID}" Width="100"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding ProductID}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding ProductID}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>


        <!-- ================= FOOTER ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left comments -->
            <StackPanel Grid.Column="0" Margin="0,0,10,30">
                <Border  Style="{StaticResource InputBorderStyle}">
                    <Grid>
                        <TextBlock Text="Other Comments" Width="150"
Foreground="LightGray"
Margin="18,0,30,0"
VerticalAlignment="Center"
IsHitTestVisible="False"
Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border  Style="{StaticResource InputBorderStyle}"  Margin="0,0,0,5" Height="100" Width="400">
                    <Grid>
                        <TextBox x:Name="Include"
  
  Background="Transparent"
  BorderThickness="0"
  Foreground="White"
  Padding="5,5,5,5"
  VerticalContentAlignment="Top"
  AcceptsReturn="True"
  TextWrapping="Wrap"
  VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text=" Please include the invoice number on your POP
Please note that quotes are valid for 7 days only, and prices 
may All orders require full payment up front before being processed. 
 Apon any purchase you agree to our terms and conditions."
    Foreground="LightGray"
    Margin="8,5,10,0"
    VerticalAlignment="Top"
    IsHitTestVisible="False"
    Height="80"                             
    Visibility="{Binding Text, ElementName=AddressTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Border  Style="{StaticResource InputBorderStyle}"  Margin="0,0,0,0" Height="100" Width="400">
                    <Grid>
                        <TextBox x:Name="Adix"
  
  Background="Transparent"
  BorderThickness="0"
  Foreground="White"
  Padding="5,5,5,5"
  VerticalContentAlignment="Top"
  AcceptsReturn="True"
  TextWrapping="Wrap"
  VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text=" Adix Shooting Tactical   
FNB Business Account    
 Acc: 62737653445     
Branch: 250655"
    Foreground="LightGray"
    Margin="8,5,10,0"
    VerticalAlignment="Top"
    IsHitTestVisible="False"
    Height="80"                             
    Visibility="{Binding Text, ElementName=AddressTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right totals -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border  Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <TextBlock Text="Sub Total" Width="150"
Foreground="LightGray"
Margin="18,0,30,0"
VerticalAlignment="Center"
IsHitTestVisible="False"
Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="VAT # " Width="150"
Foreground="LightGray"
Margin="18,0,30,0"
VerticalAlignment="Center"
IsHitTestVisible="False"
Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="Discount " Width="150"
Foreground="LightGray"
Margin="18,0,30,0"
VerticalAlignment="Center"
IsHitTestVisible="False"
Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border  Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBlock Text="Total " Width="150"
Foreground="LightGray"
Margin="18,0,30,0"
VerticalAlignment="Center"
IsHitTestVisible="False"
Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Thank You Footer -->
        
        <TextBlock Grid.Row="3" Text="Thank You For Your Business!" 
                   FontWeight="Bold" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,60,0,0"/>
        
        
    </Grid>
</Page>
