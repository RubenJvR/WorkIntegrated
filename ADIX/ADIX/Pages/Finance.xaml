<Page x:Class="ADIX.Finance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Finance">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Metric TextBlock Style -->
        <Style x:Key="MetricTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Placeholder styles -->
        <Style x:Key="PlaceholderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder - Same style as your POS page -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                Text="{TemplateBinding Tag}"
                                Foreground="LightGray"
                                Margin="8,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                       Content="{TemplateBinding SelectionBoxItem}"
                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                   Focusable="False"
                                   IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ClickMode="Press"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded dark CheckBox style -->
        <Style x:Key="RoundedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Custom tick box -->
                                    <Border x:Name="CheckMarkBorder"
                                    Width="16"
                                    Height="16"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                        <Path x:Name="CheckMark"
                                      Data="M 2 8 L 6 12 L 14 2"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Content text -->
                                    <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Finance Header -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Finance Dashboard"/>
                </Border>

                <!-- Finance Metrics -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1">
                        <TextBlock x:Name="MonthlyTurnover" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Turnover&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="MonthlyExpense" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Expense&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="ProfitLoss" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Profit / Loss&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="OutstandingSuppPayment" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Outstanding Payments&#x0a;Loading..."/>
                    </Border>
                </StackPanel>

                <!-- Expense Breakdown -->
                <Border Style="{StaticResource HeaderBorderStyle}" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Expense Breakdown"/>
                </Border>

                <!-- Expense Breakdown Table -->
                <ScrollViewer Margin="0,10,0,10" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="200">
                    <DataGrid x:Name="PosItemGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="14">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='R {0:N2}'}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Financial Overview Placeholder -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Financial Overview"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <!-- Pie Chart Placeholder -->
                    <Border Style="{StaticResource PlaceholderBorderStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Expense Distribution" FontWeight="Bold" Style="{StaticResource PlaceholderTextStyle}"/>
                            <TextBlock Text="Pie Chart" Style="{StaticResource PlaceholderTextStyle}" Margin="0,5,0,0"/>
                            <TextBlock Text="(Available when database ready)" Style="{StaticResource PlaceholderTextStyle}" FontSize="10" Margin="0,10,0,0"/>
                            <Border Width="80" Height="80" Background="#E0E0E0" CornerRadius="40" Margin="0,5,0,0">
                                <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Line Chart Placeholder -->
                    <Border Style="{StaticResource PlaceholderBorderStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Monthly Turnover" FontWeight="Bold" Style="{StaticResource PlaceholderTextStyle}"/>
                            <TextBlock Text="Line Chart" Style="{StaticResource PlaceholderTextStyle}" Margin="0,5,0,0"/>
                            <TextBlock Text="(Available when database ready)" Style="{StaticResource PlaceholderTextStyle}" FontSize="10" Margin="0,10,0,0"/>
                            <Border Width="100" Height="40" Background="#E0E0E0" CornerRadius="5" Margin="0,5,0,0">
                                <TextBlock Text="⎺⎺⎺⎺⎺" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Column Chart Placeholder -->
                    <Border Style="{StaticResource PlaceholderBorderStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Profit/Loss Trend" FontWeight="Bold" Style="{StaticResource PlaceholderTextStyle}"/>
                            <TextBlock Text="Column Chart" Style="{StaticResource PlaceholderTextStyle}" Margin="0,5,0,0"/>
                            <TextBlock Text="(Available when database ready)" Style="{StaticResource PlaceholderTextStyle}" FontSize="10" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Border Width="15" Height="30" Background="#4AA902" Margin="2" CornerRadius="2"/>
                                <Border Width="15" Height="45" Background="#4AA902" Margin="2" CornerRadius="2"/>
                                <Border Width="15" Height="25" Background="#4AA902" Margin="2" CornerRadius="2"/>
                                <Border Width="15" Height="35" Background="#4AA902" Margin="2" CornerRadius="2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Supplier Payments Section -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Supplier Payments"/>
                </Border>

                <!-- Filter Controls with Styled ComboBoxes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
                    <!-- Supplier Filter ComboBox -->
                    <ComboBox Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Suppliers"
                              SelectedIndex="0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Suppliers" IsSelected="True"/>
                        <ComboBoxItem Content="GreenFoods Ltd"/>
                        <ComboBoxItem Content="BeverageCorp"/>
                        <ComboBoxItem Content="SnackSupply Co"/>
                    </ComboBox>

                    <!-- Status Filter ComboBox -->
                    <ComboBox Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Status"
                              Margin="10,0,0,0"
                              SelectedIndex="0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Partial"/>
                    </ComboBox>

                    <!-- Date Filter ComboBox -->
                    <ComboBox Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Dates"
                              Margin="10,0,0,0"
                              SelectedIndex="0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Dates" IsSelected="True"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="Last 3 Months"/>
                    </ComboBox>
                </StackPanel>

                <!-- Supplier Payments Table -->
                <ScrollViewer Margin="0,10,0,10" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="250">
                    <DataGrid x:Name="SupplierTable"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="120"/>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="100"/>
                            <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate}" Width="100"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding InvoiceAmount, StringFormat='R {0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='R {0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat='R {0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Refresh Data" Width="120" Height="40"
                            Background="#4F4F4F" Foreground="White"
                            Click="RefreshButton_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SolidButtonStyle}"/>

                    <Button Content="Export to PDF" Width="120" Height="40"
                            Background="#4AA902" Foreground="White"
                            Click="ExportButton_Click"
                            Style="{StaticResource SolidButtonStyle}"/>
                </StackPanel>

                <!-- Status Bar -->
                <Border Background="#2D2D2D" Height="30" Margin="0,10,0,0" CornerRadius="3">
                    <TextBlock x:Name="StatusText" 
                               Text="Finance Dashboard Ready - Using sample data for demonstration" 
                               Foreground="LightGreen" 
                               VerticalAlignment="Center" 
                               Margin="10,0"
                               FontSize="11"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>