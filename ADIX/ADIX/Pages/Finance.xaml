<Page x:Class="ADIX.Finance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Finance">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Metric TextBlock Style -->
        <Style x:Key="MetricTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Chart Border Style - ENLARGED -->
        <Style x:Key="ChartBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="380"/>
            <Setter Property="Height" Value="350"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- DataGrid Container Style -->
        <Style x:Key="DataGridContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="MaxHeight" Value="300"/>
        </Style>

        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                Text="{TemplateBinding Tag}"
                                Foreground="LightGray"
                                Margin="8,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                       Content="{TemplateBinding SelectionBoxItem}"
                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                   Focusable="False"
                                   IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ClickMode="Press"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Finance Header -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Finance Dashboard"/>
                </Border>

                <!-- Finance Metrics -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15">
                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1">
                        <TextBlock x:Name="MonthlyTurnover" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Turnover&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="MonthlyExpense" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Expense&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="ProfitLoss" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Profit / Loss&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="OutstandingSuppPayment" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Outstanding Payments&#x0a;Loading..."/>
                    </Border>
                </StackPanel>

                <!-- ========== EXPENSE MANAGEMENT SECTION ========== -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="EXPENSE MANAGEMENT"/>
                </Border>

                <!-- Add Expense Input Section -->
                <Border Margin="0,5,0,15" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Expense Type -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Expense Type" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ExpenseTypeComboBox" 
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      Tag="Select Expense Type"
                                      Height="30">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="white"/>
                                        <Setter Property="Background" Value="#4F4F4F"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Rent"/>
                                <ComboBoxItem Content="Utilities"/>
                                <ComboBoxItem Content="Salaries"/>
                                <ComboBoxItem Content="Marketing"/>
                                <ComboBoxItem Content="Supplies"/>
                                <ComboBoxItem Content="Maintenance"/>
                                <ComboBoxItem Content="Transport"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Amount -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Amount (R)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="ExpenseAmountTextBox" 
                                     Background="#4F4F4F" 
                                     Foreground="White" 
                                     BorderBrush="Black" 
                                     BorderThickness="1"
                                     Height="30"
                                     Padding="5"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Date" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <DatePicker x:Name="ExpenseDatePicker" 
                                        Background="#4F4F4F" 
                                        Foreground="black"
                                        Height="30"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Description" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="ExpenseDescriptionTextBox" 
                                     Background="#4F4F4F" 
                                     Foreground="White" 
                                     BorderBrush="Black" 
                                     BorderThickness="1"
                                     Height="30"
                                     Padding="5"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Add Button -->
                        <Button Grid.Column="4" Grid.Row="0" 
                                Content="Add Expense" 
                                Width="100" 
                                Height="30" 
                                Background="#4AA902" 
                                Foreground="White"
                                FontWeight="Bold"
                                Click="AddExpenseButton_Click"
                                Margin="0,20,0,0"
                                Style="{StaticResource SolidButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Expense Breakdown -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="EXPENSE BREAKDOWN"/>
                </Border>
              

                <Border Style="{StaticResource DataGridContainerStyle}">
                    <DataGrid x:Name="ExpenseGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='R {0:N2}'}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ========== STAFF MANAGEMENT SECTION ========== -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="STAFF MANAGEMENT"/>
                </Border>

                <!-- Salary Payments Input -->
                <Border Margin="0,5,0,15" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Staff Selection -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Select Staff" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="StaffSelectionComboBox" 
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      Tag="Select Staff Member"
                                      Height="30"
                                      DisplayMemberPath="name"
                                      SelectionChanged="StaffSelectionComboBox_SelectionChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="white"/>
                                        <Setter Property="Background" Value="#4F4F4F"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>

                        <!-- Salary Amount -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Salary Amount (R)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="SalaryAmountTextBox" 
                                     Background="#4F4F4F" 
                                     Foreground="White" 
                                     BorderBrush="Black" 
                                     BorderThickness="1"
                                     Height="30"
                                     Padding="5"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SalaryAmountTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Payment Date -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,10">
                            <TextBlock Text="Payment Date" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            <DatePicker x:Name="SalaryPaymentDatePicker" 
                                        Background="#4F4F4F" 
                                        Foreground="black"
                                        Height="30"
                                        SelectedDate="{x:Static sys:DateTime.Today}"
                                        SelectedDateFormat="Short"
                                        VerticalAlignment="Top"/>
                        </StackPanel>

                        <!-- Pay Salary Button -->
                        <Button Grid.Column="3" Grid.Row="0" 
                                x:Name="PaySalaryButton"
                                Content="Pay Salary" 
                                Width="100" 
                                Height="30" 
                                Background="#4AA902" 
                                Foreground="White"
                                FontWeight="Bold"
                                Click="PaySalaryButton_Click"
                                Margin="0,20,0,0"
                                IsEnabled="False"
                                Style="{StaticResource SolidButtonStyle}"/>

                        <!-- Staff Details -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0">
                            <Border Background="#2D2D2D" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedStaffDetails" 
                                               Text="No staff member selected" 
                                               Foreground="LightGreen" 
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SalaryCalculationDetails" 
                                               Text="" 
                                               Foreground="LightGray" 
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Staff Salary Records -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="STAFF SALARY RECORD"/>
                </Border>


                <Border Style="{StaticResource DataGridContainerStyle}">
                    <DataGrid x:Name="StaffSalaryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              AlternatingRowBackground="#5A5A5A"
                              SelectionChanged="StaffSalaryGrid_SelectionChanged">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Staff ID" Binding="{Binding staffID}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Monthly Salary" Binding="{Binding salary, StringFormat='R {0:N2}'}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding userName}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Last Modified" Binding="{Binding lastModified}" Width="180" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Salary Payment History -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="SALARY PAYMENT HISTORY"/>
                </Border>


                <Border Style="{StaticResource DataGridContainerStyle}">
                    <DataGrid x:Name="SalaryPaymentHistoryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Payment ID" Binding="{Binding PaymentID}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Staff ID" Binding="{Binding staffID}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Staff Name" Binding="{Binding StaffName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='R {0:N2}'}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="380" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ========== FINANCIAL OVERVIEW SECTION ========== -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="FINANCIAL OVERVIEW"/>
                </Border>


                <!-- Charts Container -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Pie Chart -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Expense Distribution"/>
                                <lvc:PieChart x:Name="PieChart" 
                     Series="{Binding ExpenseSeries}"
                     LegendLocation="Bottom"
                     Hoverable="True"
                     InnerRadius="80"
                     Width="340" 
                     Height="260"
                     Margin="0,5,0,0">
                                    <lvc:PieChart.ChartLegend>
                                        <lvc:DefaultLegend 
                    Foreground="Black" 
                    FontSize="10"
                    Margin="0,10,0,0"
                    MaxWidth="300"/>
                                    </lvc:PieChart.ChartLegend>
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip 
                    SelectionMode="OnlySender" 
                    ShowTitle="True"
                    ShowSeries="True"
                    Foreground="White"
                    Background="#2D2D2D"
                    BorderBrush="#4AA902"
                    BorderThickness="2"
                    FontSize="12"
                    FontWeight="Bold"
                    CornerRadius="5"/>
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>
                            </StackPanel>
                        </Border>

                        <!-- Line Chart -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Monthly Turnover"/>
                                <lvc:CartesianChart x:Name="LineChart" 
                                                   Series="{Binding TurnoverSeries}"
                                                   LegendLocation="None"
                                                   Width="320" 
                                                   Height="250"
                                                   Margin="0,10,0,0">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding TurnoverLabels}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding AmountFormatter}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="#E0E0E0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <!-- Column Chart -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Profit/Loss Trend"/>
                                <lvc:CartesianChart x:Name="ColumnChart" 
                                                   Series="{Binding ProfitLossSeries}"
                                                   LegendLocation="None"
                                                   Width="320" 
                                                   Height="250"
                                                   Margin="0,10,0,0">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding ProfitLossLabels}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding AmountFormatter}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="#E0E0E0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== SUPPLIER PAYMENTS SECTION ========== -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="SUPPLIER PAYMENT"/>
                </Border>


                <!-- Filter Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
                    <!-- Supplier Filter ComboBox -->
                    <ComboBox x:Name="SupplierFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Suppliers"
                              SelectionChanged="SupplierFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Suppliers" IsSelected="True"/>
                        <ComboBoxItem Content="Precision Bows Ltd"/>
                        <ComboBoxItem Content="Eagle Arrows Co"/>
                        <ComboBoxItem Content="TargetCraft Supplies"/>
                    </ComboBox>

                    <!-- Status Filter ComboBox -->
                    <ComboBox x:Name="StatusFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Status"
                              Margin="10,0,0,0"
                              SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Partial"/>
                    </ComboBox>

                    <!-- Date Filter ComboBox -->
                    <ComboBox x:Name="DateFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Dates"
                              Margin="10,0,0,0"
                              SelectionChanged="DateFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Dates" IsSelected="True"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="Last 3 Months"/>
                    </ComboBox>
                </StackPanel>

                <!-- Supplier Payments Table -->
                <Border Style="{StaticResource DataGridContainerStyle}">
                    <DataGrid x:Name="SupplierTable"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#4F4F4F"
                              Foreground="White"
                              GridLinesVisibility="All"
                              BorderBrush="Black"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="35"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding InvoiceAmount, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,10">
                    <Button Content="Refresh Data" Width="120" Height="40"
                            Background="#4F4F4F" Foreground="White"
                            Click="RefreshButton_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SolidButtonStyle}"/>

                    <Button Content="Export to PDF" Width="120" Height="40"
                            Background="#4AA902" Foreground="White"
                            Click="ExportButton_Click"
                            Style="{StaticResource SolidButtonStyle}"/>
                </StackPanel>

                <!-- Status Bar -->
                <Border Background="#2D2D2D" Height="30" Margin="0,10,0,0" CornerRadius="3">
                    <TextBlock x:Name="StatusText" 
                               Text="Finance Dashboard Ready - Using sample data for demonstration" 
                               Foreground="LightGreen" 
                               VerticalAlignment="Center" 
                               Margin="10,0"
                               FontSize="11"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>