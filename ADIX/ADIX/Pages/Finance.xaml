<Page x:Class="ADIX.Finance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Finance">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Metric TextBlock Style -->
        <Style x:Key="MetricTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Chart Border Style - ENLARGED -->
        <Style x:Key="ChartBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="380"/>
            <Setter Property="Height" Value="350"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                Text="{TemplateBinding Tag}"
                                Foreground="LightGray"
                                Margin="8,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                       Content="{TemplateBinding SelectionBoxItem}"
                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                   Focusable="False"
                                   IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ClickMode="Press"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Finance Header -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Finance Dashboard"/>
                </Border>

                <!-- Finance Metrics -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1">
                        <TextBlock x:Name="MonthlyTurnover" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Turnover&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="MonthlyExpense" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Monthly Expense&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="ProfitLoss" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Profit / Loss&#x0a;Loading..."/>
                    </Border>

                    <Border Width="180" Height="60" Background="#4F4F4F" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                        <TextBlock x:Name="OutstandingSuppPayment" 
                                   Style="{StaticResource MetricTextBlockStyle}"
                                   Text="Outstanding Payments&#x0a;Loading..."/>
                    </Border>
                </StackPanel>

                <!-- Expense Breakdown -->
                <Border Style="{StaticResource HeaderBorderStyle}" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Expense Breakdown"/>
                </Border>

                <!-- Expense Breakdown Table -->
                <Border Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" MaxHeight="200">
                    <DataGrid x:Name="ExpenseGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="14"
              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='R {0:N2}'}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <!-- Financial Overview -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Financial Overview"/>
                </Border>

                <!-- Charts Container - IMPROVED LAYOUT -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Pie Chart - CLEAN VERSION WITH BETTER TOOLTIPS -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Expense Distribution"/>
                                <lvc:PieChart x:Name="PieChart" 
                     Series="{Binding ExpenseSeries}"
                     LegendLocation="Bottom"
                     Hoverable="True"
                     InnerRadius="80"
                     Width="340" 
                     Height="260"
                     Margin="0,5,0,0">
                                    <lvc:PieChart.ChartLegend>
                                        <lvc:DefaultLegend 
                    Foreground="Black" 
                    FontSize="10"
                    Margin="0,10,0,0"
                    MaxWidth="300"/>
                                    </lvc:PieChart.ChartLegend>
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip 
                    SelectionMode="OnlySender" 
                    ShowTitle="True"
                    ShowSeries="True"
                    Foreground="White"
                    Background="#2D2D2D"
                    BorderBrush="#4AA902"
                    BorderThickness="2"
                    FontSize="12"
                    FontWeight="Bold"
                    CornerRadius="5"/>
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>
                            </StackPanel>
                        </Border>
                        
                        
                        <!-- Line Chart - ENLARGED -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Monthly Turnover"/>
                                <lvc:CartesianChart x:Name="LineChart" 
                                                   Series="{Binding TurnoverSeries}"
                                                   LegendLocation="None"
                                                   Width="320" 
                                                   Height="250"
                                                   Margin="0,10,0,0">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding TurnoverLabels}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding AmountFormatter}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="#E0E0E0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <!-- Column Chart - ENLARGED -->
                        <Border Style="{StaticResource ChartBorderStyle}">
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Profit/Loss Trend"/>
                                <lvc:CartesianChart x:Name="ColumnChart" 
                                                   Series="{Binding ProfitLossSeries}"
                                                   LegendLocation="None"
                                                   Width="320" 
                                                   Height="250"
                                                   Margin="0,10,0,0">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding ProfitLossLabels}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding AmountFormatter}" 
                                                  Foreground="Black"
                                                  FontSize="11">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="#E0E0E0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Supplier Payments Section -->
                <Border Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Supplier Payments"/>
                </Border>

                <!-- Filter Controls with Styled ComboBoxes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
                    <!-- Supplier Filter ComboBox -->
                    <ComboBox x:Name="SupplierFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Suppliers"
                              SelectionChanged="SupplierFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Suppliers" IsSelected="True"/>
                        <ComboBoxItem Content="Precision Bows Ltd"/>
                        <ComboBoxItem Content="Eagle Arrows Co"/>
                        <ComboBoxItem Content="TargetCraft Supplies"/>
                    </ComboBox>

                    <!-- Status Filter ComboBox -->
                    <ComboBox x:Name="StatusFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Status"
                              Margin="10,0,0,0"
                              SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Partial"/>
                    </ComboBox>

                    <!-- Date Filter ComboBox -->
                    <ComboBox x:Name="DateFilterComboBox"
                              Width="150" 
                              Style="{StaticResource RoundedComboBoxStyle}"
                              Tag="All Dates"
                              Margin="10,0,0,0"
                              SelectionChanged="DateFilter_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="white"/>
                                <Setter Property="Background" Value="#4F4F4F"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Dates" IsSelected="True"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="Last 3 Months"/>
                    </ComboBox>
                </StackPanel>

                <!-- Supplier Payments Table -->
                <Border Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" MaxHeight="250">
                    <DataGrid x:Name="SupplierTable"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="12"
              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Amount" Binding="{Binding InvoiceAmount, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat='R {0:N2}'}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Refresh Data" Width="120" Height="40"
                            Background="#4F4F4F" Foreground="White"
                            Click="RefreshButton_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SolidButtonStyle}"/>

                    <Button Content="Export to PDF" Width="120" Height="40"
                            Background="#4AA902" Foreground="White"
                            Click="ExportButton_Click"
                            Style="{StaticResource SolidButtonStyle}"/>
                </StackPanel>

                <!-- Status Bar -->
