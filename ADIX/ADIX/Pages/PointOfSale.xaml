<Page x:Class="ADIX.PointOfSale"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PointOfSale">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="LightGray"
                                       Margin="8,0,30,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded input style (TextBox + ComboBox)  (Might delete)-->
        <Style x:Key="RoundedInputStyle" TargetType="Control">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <local:Sidebar Grid.Column="0" Margin="0,0,10,209"/>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <!-- Customer -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Sales Staff -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Payment Method -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Payment Received -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- VAT -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Totals -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ADIX POS"/>
            </Border>

            <!-- Customer Name TextBox -->
            <Border Grid.Row="2" Style="{StaticResource InputBorderStyle}">
                <Grid>
                    <TextBox x:Name="CustomerNameTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="5,0,5,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Customer Name"
                               Foreground="LightGray"
                               Margin="8,0,30,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                </Grid>
            </Border>


            <!-- Sales Staff ComboBox -->
            <ComboBox Grid.Row="4"
                      x:Name="SalesStuff"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Tag="Sales Staff"
                      SelectedIndex="-1">
                <ComboBoxItem Content="OL"/>
                <ComboBoxItem Content="IV"/>
                <ComboBoxItem Content="TR"/>
                <ComboBoxItem Content="REN"/>
                <ComboBoxItem Content="AP"/>
            </ComboBox>

            <!-- Payment Method ComboBox -->
            <ComboBox Grid.Row="6"
                      x:Name="PaymentMethod"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Tag="Payment Method"
                      SelectedIndex="-1">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="EFT"/>
                <ComboBoxItem Content="Credit"/>
                <ComboBoxItem Content="Return"/>
            </ComboBox>

            <!-- Payment Received ComboBox -->
            <ComboBox Grid.Row="8"
                      x:Name="PaymentReceived"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Tag="Payment Received"
                      SelectedIndex="-1">
                <ComboBoxItem Content="Yes"/>
                <ComboBoxItem Content="No"/>
            </ComboBox>

            <!-- VAT TextBox -->
            <Border Grid.Row="10" Style="{StaticResource InputBorderStyle}">
                <Grid>
                    <TextBox x:Name="VATTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="5,0,5,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="VAT"
                               Foreground="LightGray"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=VATTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}" HorizontalAlignment="Left" Width="540"/>
                </Grid>
            </Border>

            <!-- POS Items Table -->
            <ScrollViewer Grid.Row="12" Margin="0,10,0,10"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="PosItemGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Background="#4F4F4F"
                          Foreground="White"
                          GridLinesVisibility="All"
                          BorderBrush="Black"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          CanUserAddRows="True"
                          RowHeight="35"
                          ColumnHeaderHeight="40"
                          FontSize="14"
                          Height="178">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="200"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Stock Control" Binding="{Binding StockControl}" Width="120"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount}" Width="150"/>
                        <DataGridTextColumn Header="In Stock" Binding="{Binding InStock}" Width="100"/>
                        <DataGridTextColumn Header="Item Discount" Binding="{Binding ItemDiscount}" Width="130"/>
                        <DataGridTextColumn Header="Discounted Item Amount" Binding="{Binding DiscountedItemAmount}" Width="180"/>
                        <DataGridTextColumn Header="Total Discounted" Binding="{Binding TotalDiscounted}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <!-- Totals + Info Row -->
            <Grid Grid.Row="13" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Totals -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">

                    <!-- Total Bill (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock x:Name="TotalBillText"
                       Text="Total Bill Amount: R 0.00"
                       Foreground="White"
                       Padding="5,0,5,0"
                       VerticalAlignment="Center"/>
                    </Border>

                    <!-- Total Excluding Discount (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock x:Name="TotalExclDiscountText"
                       Text="Total Excluding Discount: R 0.00"
                       Foreground="White"
                       Padding="5,0,5,0"
                       VerticalAlignment="Center"/>
                    </Border>

                    <!-- Discount % (Editable) -->
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBox x:Name="DiscountPercentTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         Padding="5,0,5,0"
                         VerticalContentAlignment="Center"/>
                            <TextBlock Text="Discount %"
                           Foreground="LightGray"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=DiscountPercentTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Middle Info -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">

                    <!-- Date (ReadOnly, Auto-filled in code) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock x:Name="DateText"
                       Text="Date"
                       Foreground="White"
                       Padding="5,0,5,0"
                       VerticalAlignment="Center"/>
                    </Border>

                    <!-- Invoice # (ReadOnly, Auto-filled in code) -->
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBlock x:Name="InvoiceText"
                       Text="Invoice #"
                       Foreground="White"
                       Padding="5,0,5,0"
                       VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right Address (Editable, Bigger Height) -->
                <Border Grid.Column="2" Style="{StaticResource InputBorderStyle}" Margin="5">
                    <Grid>
                        <TextBox x:Name="AddressTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     Padding="5,0,5,0"
                     VerticalContentAlignment="Top"
                     Height="100"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
                        <TextBlock Text="Address"
                       Foreground="LightGray"
                       Margin="8,5,0,0"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Visibility="{Binding Text, ElementName=AddressTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>



            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="14" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Cancel Transaction" Width="150" Height="40"
                        Background="Red" Foreground="White" FontWeight="Bold" Margin="5"/>
                <Button Content="Checkout" Width="150" Height="40"
                        Background="Green" Foreground="White" FontWeight="Bold" Margin="5"/>
                <Button Content="Quote" Width="150" Height="40"
                        Background="#4F4F4F" Foreground="White" Margin="5"/>
                <Button Content="Print" Width="150" Height="40"
                        Background="#4F4F4F" Foreground="White" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
