<Page x:Class="ADIX.PointOfSale"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PointOfSale">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                Text="{TemplateBinding Tag}"
                                Foreground="LightGray"
                                Margin="8,0,30,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                       Content="{TemplateBinding SelectionBoxItem}"
                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                   Focusable="False"
                                   IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ClickMode="Press"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded dark CheckBox style -->
        <Style x:Key="RoundedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Custom tick box -->
                                    <Border x:Name="CheckMarkBorder"
                                    Width="16"
                                    Height="16"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                        <Path x:Name="CheckMark"
                                      Data="M 2 8 L 6 12 L 14 2"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Content text -->
                                    <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Page.Resources>
    
    

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <local:Sidebar Grid.Column="0" Margin="0,0,10,209"/>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ADIX POS"/>
            </Border>

            <!-- Customer Name TextBox -->
            <Border Grid.Row="2" Style="{StaticResource InputBorderStyle}">
                <Grid>
                    <TextBox x:Name="CustomerNameTextBox"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="5,0,5,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Customer Name"
                               Foreground="LightGray"
                               Margin="8,0,30,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=CustomerNameTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Sales Staff ComboBox -->
            <Grid Grid.Row="4">
                <ComboBox ItemsSource="{Binding StaffMembers}"
              SelectedItem="{Binding SelectedStaff}"
              DisplayMemberPath="Name"
              Tag="Sales Staff"    
                    Style="{StaticResource RoundedComboBoxStyle}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="white"/>
                            <Setter Property="Background" Value="#4F4F4F"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Grid>

            <!-- Payment Method ComboBox -->
            <Grid Grid.Row="6">
                <ComboBox ItemsSource="{Binding PaymentMethods}"
                          SelectedItem="{Binding SelectedPaymentMethod}"
                          Style="{StaticResource RoundedComboBoxStyle}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="white"/>
                            <Setter Property="Background" Value="#4F4F4F"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="Payment Method"
                           Foreground="LightGray"
                           Margin="8,0,30,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding SelectedPaymentMethod, Converter={StaticResource NullToVisibilityConverter}}"/>
            </Grid>

            <!-- Payment Received Checkbox -->
            <CheckBox Grid.Row="8"
                      Content="Payment Received"
                      IsChecked="{Binding PaymentReceived}"
                      
                     Style="{StaticResource RoundedCheckBoxStyle}"/>

            <!-- VAT TextBox -->
            <Border Grid.Row="10" Style="{StaticResource InputBorderStyle}">
                <Grid>
                    <TextBox x:Name="VATTextBox"
                             Text="{Binding VATAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="5,0,5,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="VAT Amount"
                               Foreground="LightGray"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=VATTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- POS Items Table -->
            <ScrollViewer Grid.Row="12" Margin="0,10,0,10"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="ItemsGrid"
                          ItemsSource="{Binding CartItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Background="#4F4F4F"
                          Foreground="White"
                          GridLinesVisibility="All"
                          BorderBrush="Black"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeight="35"
                          ColumnHeaderHeight="40"
                          FontSize="14"
                          AlternatingRowBackground="#5A5A5A">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#4AA902"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#4F4F4F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A5A5A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="200" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stock Control" Binding="{Binding StockControl}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=F2}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=F2}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="In Stock" Binding="{Binding InStock}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Item Discount %" Binding="{Binding ItemDiscount, UpdateSourceTrigger=PropertyChanged}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Discounted Amount" Binding="{Binding DiscountedItemAmount, StringFormat=F2}" Width="180" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total Discounted" Binding="{Binding TotalDiscounted, StringFormat=F2}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <!-- Totals + Info Row -->
            <Grid Grid.Row="13" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Totals -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">
                    <!-- Total Bill (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock Text="{Binding TotalBill, StringFormat='Total Bill Amount: R {0:F2}'}"
                                   Foreground="White"
                                   Padding="5,0,5,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- Total Excluding Discount (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock Text="{Binding TotalExcludingDiscount, StringFormat='Total Excluding Discount: R {0:F2}'}"
                                   Foreground="White"
                                   Padding="5,0,5,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Discount % (Editable) -->
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid>
                            <TextBox x:Name="DiscountPercentTextBox"
                                     Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     Padding="5,0,5,0"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="Overall Discount %"
                                       Foreground="LightGray"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=DiscountPercentTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Middle Info -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">
                    <!-- Date (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                        <TextBlock Text="{Binding CurrentDate, StringFormat='Date: {0}'}"
                                   Foreground="White"
                                   Padding="5,0,5,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Invoice # (ReadOnly) -->
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBlock Text="{Binding InvoiceNumber, StringFormat='Invoice #: {0}'}"
                                   Foreground="White"
                                   Padding="5,0,5,0"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right Address (Editable) -->
                <Border Grid.Column="2" Style="{StaticResource InputBorderStyle}" Margin="5" Height="100">
                    <Grid>
                        <TextBox x:Name="AddressTextBox"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 Padding="5,5,5,5"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Customer Address"
                                   Foreground="LightGray"
                                   Margin="8,5,0,0"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=AddressTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="14" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                
                <Button Content="Cancel Transaction" 
                        Command="{Binding CancelTransactionCommand}"
                        Width="150" Height="40"
                        Background="Red" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Margin="5"
                        Cursor="Hand"/>

                <Button Content="Checkout" Width="150" Height="40"
                 Background="Green" Foreground="White" FontWeight="Bold" Margin="5"/>

                <Button Content="Qoute" Width="150" Height="40"
                 Background="Green" Foreground="White" FontWeight="Bold" Margin="5" Click="Quote_Click"/>
                
                <Button Content="Invoice" Width="150" Height="40"
                 Background="Green" Foreground="White" FontWeight="Bold" Margin="5" Click="Invoice_Click"/>

                
            </StackPanel>
        </Grid>
    </Grid>
</Page>