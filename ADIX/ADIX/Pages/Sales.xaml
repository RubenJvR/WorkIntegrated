<Page x:Class="ADIX.Sales"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:ADIX;assembly=ADIX"
      xmlns:converters="clr-namespace:ADIX"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Sales">

	<Page.Resources>
		<!-- Converters -->
		<converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
		<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

		<!-- Header styles -->
		<Style x:Key="HeaderBorderStyle" TargetType="Border">
			<Setter Property="Background" Value="#4AA902"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="23"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Rounded input border -->
		<Style x:Key="InputBorderStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="#4F4F4F"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<!-- Rounded ComboBox with placeholder -->
		<Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#4F4F4F"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="5,0,30,0"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    MouseLeftButtonDown="ComboBoxBorder_MouseLeftButtonDown"/>
							<!-- Placeholder -->
							<TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="LightGray"
                                       Margin="8,0,30,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
							<!-- Selected item -->
							<ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,30,0"
                                              IsHitTestVisible="False"/>
							<!-- Toggle button arrow -->
							<ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Grid Background="Transparent">
											<Path Fill="White"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Stretch="Uniform"
                                                  Width="10"
                                                  Height="6"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
										</Grid>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<!-- Dropdown Popup -->
							<Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
								<Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
									<ScrollViewer Margin="0" SnapsToDevicePixels="True">
										<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Rounded input style (TextBox + ComboBox)  (Might delete)-->
		<Style x:Key="RoundedInputStyle" TargetType="Control">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#4F4F4F"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="5,0,5,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Control">
						<Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Page.Resources>

	<Grid Background="#878787">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<!--<local:Sidebar Grid.Column="0" Margin="0,0,10,209"/>-->

		<!-- Main Content -->
		<Grid Grid.Column="1" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Supplier -->
				<RowDefinition Height="10"/>
				<RowDefinition Height="Auto"/>
				<!-- Date Range -->
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<!-- Stock Type -->
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<!-- Low Stock-->
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<!-- Payment Status -->
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<!-- VAT -->
				<RowDefinition Height="8"/>
				<RowDefinition Height="*"/>
				<!-- DataGrid -->
				<RowDefinition Height="Auto"/>

				<!-- Buttons -->
			</Grid.RowDefinitions>

			<!-- Header -->
			<Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Sales"/>
			</Border>


			<!-- Select date Sales-->
			<StackPanel Grid.Row="2" Orientation="Vertical">
				<!-- Main date range selector -->
				<ComboBox x:Name="SalesDate"
              Style="{StaticResource RoundedComboBoxStyle}"
              Tag="Select Date"
              SelectedIndex="-1"
              SelectionChanged="SalesDate_SelectionChanged">
					<ComboBoxItem Content="All Time"/>
					<ComboBoxItem Content="This Month"/>
					<ComboBoxItem Content="Last 30 Days"/>
					<ComboBoxItem Content="Custom"/>
				</ComboBox>



				<!-- Custom range pickers (hidden by default) -->
				<StackPanel x:Name="CustomDatePanel"
            Orientation="Horizontal"
            Margin="0,5,0,0"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
					<DatePicker x:Name="StartDatePicker"
                Width="150"
                SelectedDate="{x:Static sys:DateTime.Now}"
                Margin="0,0,10,0"/>

					<TextBlock Text="to"
               VerticalAlignment="Center"
               Foreground="White"
               Margin="0,0,10,0"/>

					<DatePicker x:Name="EndDatePicker"
                Width="150"
                SelectedDate="{x:Static sys:DateTime.Now}"/>
				</StackPanel>
			</StackPanel>

			<!-- Search Transaction :-->
			<Border Grid.Row="4" Style="{StaticResource InputBorderStyle}">
				<Grid>
					<TextBox x:Name="TransactionSearch"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Padding="5,0,5,0"
                  VerticalContentAlignment="Center"/>
					<TextBlock Text="Search Transaction by ID, Customer name , or cashier"
                    Foreground="LightGray"
                    Margin="8,0,30,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding Text, ElementName=TransactionSearch, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
				</Grid>
			</Border>



			<!-- Payment method-->
			<ComboBox Grid.Row="6"
                      x:Name="PaymentMethod"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Tag="Payment Method"
                      SelectedIndex="-1">
				<ComboBoxItem Content="All"/>
				<ComboBoxItem Content="Cash"/>
				<ComboBoxItem Content="EFT"/>
				<ComboBoxItem Content="Credit"/>
				<ComboBoxItem Content="Return"/>

			</ComboBox>



			<!-- Header -->
			<Border Grid.Row="8" Style="{StaticResource HeaderBorderStyle}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Sales Table"/>
			</Border>




            <!-- Sales Table -->
            <Border Grid.Row="12" Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" Height="278">
                <DataGrid x:Name="SalesGrid"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="True"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="14"
              AlternatingRowBackground="#5A5A5A">

                    <!-- Column Header Styling -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Cell Styling -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#4AA902"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Row Styling -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#4F4F4F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A5A5A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNumber}" Width="120" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="170" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sales Stuff" Binding="{Binding SalesStuff}" Width="120" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="120" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Purchase Amount" Binding="{Binding PurchaseAmount}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PaymentMethod" Binding="{Binding PaymentMethod}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid}" Width="130" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

           
		</Grid>
	</Grid>
</Page>