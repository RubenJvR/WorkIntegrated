<Page x:Class="ADIX.ProductManagement"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Management" Height="650" Width="1000"
        Background="Gray" WindowStartupLocation="CenterScreen">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- SIDEBAR -->
		<StackPanel Grid.Column="0" Background="#3A3A3A" Margin="0,0,0,60">
			<Border Background="White" Margin="10" CornerRadius="5">
				<Image Source="Images/adix_logo.png" Stretch="Uniform"/>
			</Border>

			<Border Background="#4CAF50" CornerRadius="5" Margin="10,30,10,0">
				<Button Content="Products" Foreground="White" FontWeight="Bold" Height="40"
                        Background="Transparent" BorderThickness="0"/>
			</Border>
		</StackPanel>

		<!-- MAIN CONTENT -->
		<Grid Grid.Column="1" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Header -->
				<RowDefinition Height="Auto"/>
				<!-- Input Fields -->
				<RowDefinition Height="*"/>
				<!-- Table -->
				<RowDefinition Height="Auto"/>
				<!-- Button -->
				<RowDefinition Height="Auto"/>
				<!-- Footer -->
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<Border Grid.Row="0" Background="#4AA902" Margin="0,0,0,10" CornerRadius="5">
				<TextBlock Text="Product Management" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Padding="10"/>
			</Border>

			<!-- INPUT FIELDS -->
			<Border Grid.Row="1" Background="#666" Margin="0,0,0,15" CornerRadius="5">
				<StackPanel>
					<Grid Margin="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Margin="5">
							<TextBlock Text="Item Group" Foreground="White"/>
							<TextBox Background="#555" Foreground="White" BorderBrush="Gray"/>
						</StackPanel>

						<StackPanel Grid.Column="1" Margin="5">
							<TextBlock Text="Item Name" Foreground="White"/>
							<TextBox Background="#555" Foreground="White" BorderBrush="Gray"/>
						</StackPanel>

						<StackPanel Grid.Column="2" Margin="5">
							<TextBlock Text="SKU" Foreground="White"/>
							<TextBox Background="#555" Foreground="White" BorderBrush="Gray"/>
						</StackPanel>
					</Grid>



					<!-- TOGGLE SWITCHES -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">

						<!-- Low Stock Toggle -->
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
							<ToggleButton Width="60" Height="30" BorderBrush="Gray" BorderThickness="1" x:Name="LowStockToggle">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Grid>
											<Border x:Name="SwitchBorder" Background="#ccc" CornerRadius="15"/>
											<Ellipse x:Name="SwitchKnob" Fill="White" Width="26" Height="26" Margin="2"/>
										</Grid>
										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked" Value="True">
												<Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
												<Setter TargetName="SwitchKnob" Property="Margin" Value="32,2,2,2"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Text="Low Stock"/>
						</StackPanel>

						<!-- High Value Stock Toggle -->
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<ToggleButton Width="60" Height="30" BorderBrush="Gray" BorderThickness="1" x:Name="HighValueToggle">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Grid>
											<Border x:Name="SwitchBorder" Background="#ccc" CornerRadius="15"/>
											<Ellipse x:Name="SwitchKnob" Fill="White" Width="26" Height="26" Margin="2"/>
										</Grid>
										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked" Value="True">
												<Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
												<Setter TargetName="SwitchKnob" Property="Margin" Value="32,2,2,2"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Text="High Value Stock"/>
						</StackPanel>



					</StackPanel>
				</StackPanel>
			</Border>

			<!-- TABLE -->
			<ScrollViewer Grid.Row="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
				<Grid Background="White">
					<!-- Columns -->
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Rows -->
					<Grid.RowDefinitions>
						<RowDefinition Height="45"/>
						<!-- Header -->
						<RowDefinition Height="35"/>
						<!-- Row 1 -->
						<RowDefinition Height="35"/>
						<!-- Row 2 -->
						<RowDefinition Height="35"/>
						<!-- Row 3 -->
					</Grid.RowDefinitions>

					<!-- HEADER CELLS -->
					<!-- HEADER CELLS (full grey row) -->
					<Border Grid.Row="0" Grid.Column="0" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Stock Take" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="1" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Cost Price" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="2" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Selling Price" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="3" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="VAT %" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="4" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Avg Turnover" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="5" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Opening Stock" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="6" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Stock Value" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="0" Grid.Column="7" Background="#666" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="Potential Sales Value" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<!-- ROW 1 -->
					<Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R50.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R75.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="15%" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="4" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="30 Days" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="5" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="6" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R10,000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="1" Grid.Column="7" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R15,000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<!-- ROW 2 -->
					<Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R120.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R180.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="15%" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="4" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="45 Days" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="5" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="6" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R9,600" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="2" Grid.Column="7" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R14,400" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<!-- ROW 3 -->
					<Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R30.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R50.00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="15%" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="4" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="25 Days" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="5" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="6" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R1,800" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border Grid.Row="3" Grid.Column="7" BorderBrush="Black" BorderThickness="1">
						<TextBlock Text="R3,000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>

				</Grid>


			</ScrollViewer>

			<!-- PRODUCTS BUTTON BELOW TABLE -->
			<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
				<Button Content="Products" Width="160" Height="45" Background="#4AA902" Foreground="White" FontWeight="Bold">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="15"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<!-- Hover Effect -->
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#45A049"/>
								</Trigger>
								<!-- Pressed Effect (optional) -->
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#388E3C"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>





			<!-- FOOTER 
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="◀" Width="40" Margin="5" Background="#333" Foreground="White"/>
                <Button Content="▶" Width="40" Margin="5" Background="#333" Foreground="White"/>
            </StackPanel> -->
		</Grid>
	</Grid>
</Page>
