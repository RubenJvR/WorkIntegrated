<Page x:Class="ADIX.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="696.331" d:DesignWidth="800"
      Title="Dashboard"
      Background="#878787">

    <Page.Resources>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chart Styles -->
        <Style x:Key="PieChartBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#4AA902"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Improved Metric Text Styles -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4AA902"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,3,5,0"/>
        </Style>

        <Style x:Key="MetricSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,2,5,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Dashboard Header -->
                <Border Background="#4AA902" Padding="15" CornerRadius="8" Margin="0 0 0 20">
                    <TextBlock Text="Dashboard Overview" FontSize="24" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                </Border>

                <!-- Key Metrics Row -->
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Key Performance Metrics"/>
                </Border>

                <WrapPanel HorizontalAlignment="Center" Margin="0 0 0 25">
                    <!-- Stock Value -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="190" Height="110">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Style="{StaticResource MetricTitleStyle}" Text="STOCK VALUE"/>
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalStock}"/>
                            <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Total Inventory Worth"/>
                        </StackPanel>
                    </Border>

                    <!-- Sales -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="190" Height="110">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Style="{StaticResource MetricTitleStyle}" Text="SALES (30 DAYS)"/>
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalSales}"/>
                            <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Total Revenue"/>
                        </StackPanel>
                    </Border>

                    <!-- Profit -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="190" Height="110">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Style="{StaticResource MetricTitleStyle}" Text="PROFIT (30 DAYS)"/>
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalProfit}"/>
                            <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Net Profit"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent Sale -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="190" Height="110">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Style="{StaticResource MetricTitleStyle}" Text="RECENT SALE"/>
                            <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding RecentSale}" FontSize="12"/>
                            <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Latest Transaction"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Inventory & Sales Trend -->
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Inventory &amp; Sales Analysis"/>
                </Border>

                <WrapPanel HorizontalAlignment="Center" Margin="0 0 0 25">
                    <!-- Inventory Alert -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="320" Height="140">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                            <TextBlock Text="STOCK ALERTS" Foreground="White" FontSize="14" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding InventoryAlert}" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Sales Trend -->
                    <Border Style="{StaticResource MetricCardStyle}" Width="320" Height="140">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                            <TextBlock Text="SALES TREND" Foreground="White" FontSize="14" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SalesTrend}" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="14"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Finance Summary -->
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Finance Summary"/>
                </Border>

                <WrapPanel HorizontalAlignment="Center" Margin="0 0 0 20">
                    <!-- Finance Cards -->
                    <StackPanel Margin="0,0,15,0">
                        <!-- Total Expenses -->
                        <Border Style="{StaticResource MetricCardStyle}" Width="300" Height="90">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="EXPENSES (30 DAYS)"/>
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalExpenses}"/>
                                <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Total Operating Costs"/>
                            </StackPanel>
                        </Border>

                        <!-- Biggest Expense -->
                        <Border Style="{StaticResource MetricCardStyle}" Width="300" Height="90" Margin="0,10,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="MAJOR EXPENSE"/>
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding BiggestExpenseCategory}" FontSize="12"/>
                                <TextBlock Style="{StaticResource MetricSubtitleStyle}" Text="Highest Cost Category"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Pie Chart - IMPROVED LAYOUT -->
                    <Border Style="{StaticResource PieChartBorderStyle}" Width="380" Height="240" Background="White">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Expense Distribution (30 Days)" Foreground="Black"/>
                            <lvc:PieChart Series="{Binding ExpenseSeries}"
                                     LegendLocation="Bottom"
                                     Hoverable="True"
                                     InnerRadius="70"
                                     Height="170" 
                                     Width="340"
                                     Margin="0,5,0,0">
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend 
                                    Foreground="Black" 
                                    FontSize="9"
                                    Margin="0,8,0,0"
                                    MaxWidth="320"
                                    FontWeight="Bold"/>
                                </lvc:PieChart.ChartLegend>
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip 
                                    SelectionMode="OnlySender" 
                                    ShowTitle="True"
                                    ShowSeries="True"
                                    Foreground="White"
                                    Background="#2D2D2D"
                                    BorderBrush="#4AA902"
                                    BorderThickness="2"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    CornerRadius="5"/>
                                </lvc:PieChart.DataTooltip>
                            </lvc:PieChart>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>