<Page x:Class="ADIX.Invoice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      Title="Invoice">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- TextBox with placeholder style -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#878787" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Top Info -->
            <RowDefinition Height="*"/>
            <!-- Items -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
            <!-- Thank You -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
            <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Invoice"/>
        </Border>

        <!-- ================= TOP INFO ================= -->
        <Grid Grid.Row="1" Margin="0,10,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10,0,10,0">
                <!-- Logo -->
                <Border Height="120" VerticalAlignment="Top" HorizontalAlignment="Left" Width="160">
                    <Image Source="/Image/ADIX_LOGO.png"/>
                </Border>

                <!-- Payment Info -->
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5">
                    <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                             Tag="Payment"
                             Text="{Binding PaymentInfo, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Bill To -->
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                    <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                             Tag="Bill to"
                             Text="{Binding BillTo, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Customer Name -->
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                    <TextBox x:Name="CustomerNameTextBox"
                             Style="{StaticResource PlaceholderTextBoxStyle}" 
                             Tag="Customer Name"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
            </StackPanel>

            <!-- SPACER COLUMN -->
            <Grid Grid.Column="1" Width="20"/>

            <!-- RIGHT SIDE -->
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Labels -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock Text="Date:" Foreground="White" Margin="0,0,0,5" VerticalAlignment="Center"/>
                        <TextBlock Text="INV #:" Foreground="White" Margin="0,5,0,5" VerticalAlignment="Center"/>
                        <TextBlock Text="Staff ID:" Foreground="White" Margin="0,5,0,5" VerticalAlignment="Center"/>
                        <TextBlock Text="Address:" Foreground="White" Margin="0,5,0,5" VerticalAlignment="Top"/>
                    </StackPanel>

                    <!-- Input Fields -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <!-- Date -->
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5" Width="200">
                            <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                                     Text="{Binding InvoiceDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Invoice Number -->
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5" Width="200">
                            <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                                     Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Staff ID -->
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5" Width="200">
                            <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                                     Text="{Binding StaffID, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Address -->
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,0" Height="80" Width="200">
                            <TextBox x:Name="AddressTextBox"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     Padding="8,5"
                                     VerticalContentAlignment="Top"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Invoice Table -->
        <Border Grid.Row="2" Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1">
            <DataGrid x:Name="ProductsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      Background="Transparent"
                      Foreground="White"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      CanUserAddRows="True"
                      RowHeight="35"
                      ColumnHeaderHeight="40"
                      FontSize="14"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ItemsSource="{Binding InvoiceItems}">

                <!-- Column Header Styling -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Cell Styling -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <!-- Columns -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU #" Binding="{Binding SKU}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat=P2}" Width="80"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= FOOTER ================= -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left comments -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                <!-- Other Comments -->
                <TextBlock Text="Other Comments:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,10" Height="30">
                    <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                             Text="{Binding OtherComments, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Terms and Conditions -->
                <TextBlock Text="Terms &amp; Conditions:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,10" Height="80">
                    <TextBox x:Name="TermsTextBox"
                             Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="8,5"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Bank Details -->
                <TextBlock Text="Bank Details:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,0" Height="80">
                    <TextBox x:Name="BankDetailsTextBox"
                             Text="{Binding BankDetails, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="8,5"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>

            <!-- SPACER -->
            <Grid Grid.Column="1" Width="20"/>

            <!-- Right totals -->
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="Summary:" Foreground="White" Margin="0,0,0,10" FontWeight="Bold" FontSize="16"/>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sub Total:" Foreground="White" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="120">
                        <TextBlock Text="{Binding SubTotal, StringFormat=C}" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VAT:" Foreground="White" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="120">
                        <TextBlock Text="{Binding VAT, StringFormat=C}" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Discount:" Foreground="White" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="120">
                        <TextBlock Text="{Binding TotalDiscount, StringFormat=C}" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="120" Background="#3A3A3A">
                        <TextBlock Text="{Binding GrandTotal, StringFormat=C}" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Thank You Footer -->
        <TextBlock Grid.Row="4" 
                   Text="Thank You For Your Business!" 
                   FontWeight="Bold" 
                   FontSize="16"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="0,20,0,10"
                   Foreground="White"/>
    </Grid>
</Page>