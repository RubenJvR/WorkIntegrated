<Page x:Class="ADIX.Invoice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Invoice">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- TextBox with placeholder style -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Solid Button Style -->
        <Style x:Key="SolidButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="4" 
                        Padding="5,0,5,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <local:Sidebar Grid.Column="0" Margin="0,0,10,0"/>

        <!-- Main Content with ScrollViewer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10" MinHeight="700">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Header -->
                    <RowDefinition Height="10"/>
                    <!-- 1: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Top Info -->
                    <RowDefinition Height="10"/>
                    <!-- 3: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Items Table -->
                    <RowDefinition Height="10"/>
                    <!-- 5: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6: Footer -->
                    <RowDefinition Height="10"/>
                    <!-- 7: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 8: Thank You -->
                    <RowDefinition Height="10"/>
                    <!-- 9: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 10: Buttons -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Invoice"/>
                </Border>

                <!-- ================= TOP INFO ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                        <!-- Logo -->
                        <Border Height="120" VerticalAlignment="Top" HorizontalAlignment="Left" Width="160" Margin="0,0,0,10">
                            <Image Source="/Image/ADIX_LOGO.png" Stretch="Uniform"/>
                        </Border>

                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,10" Height="110">
                            <TextBox x:Name="CompanyInfoTextBox"
                                Text="Company Reg: 2017/478397/17&#x0a;283 Stepping Stones Shopping Village&#x0a;Honeydew Rd. West&#x0a;NorthRiding, 2169&#x0a;info@adix.co.za&#x0a;082 440 3703"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Padding="8,5"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                IsReadOnly="True"/>
                        </Border>

                        <!-- Bill To Section with Label -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}">
                                <TextBlock Text="{Binding BillTo, StringFormat='Bill To: {0}'}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                            </Border>
                        </Grid>

                        <!-- Customer Address Section with Label -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Margin="0,5,0,0">
                                <TextBlock Text="{Binding CustomerAddress, StringFormat='Customer Address: {0}'}"
                                    Foreground="White"
                                    VerticalAlignment="Center"
                                    Margin="8,0"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- SPACER COLUMN -->
                    <Grid Grid.Column="1" Width="20"/>

                    <!-- RIGHT SIDE -->
                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            

                            <!-- Input Fields -->
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <!-- Date -->
                                <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding InvoiceDate, StringFormat=' Date: {0}'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>       
                                </Border>

                                <!-- Invoice Number -->
                                <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5">
                                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='INV #: {0}'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>
                                </Border>

                                <!-- Staff ID -->
                                <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5">
                                    <TextBlock Text="{Binding StaffID, StringFormat='Staff ID: {0}'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>
                                </Border>

                                <!-- VAT # -->
                                <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,5">
                                    <TextBlock Text="{Binding VATNumber, StringFormat='VAT #: {0}'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>
                                </Border>

                                <!-- Payment -->
                                <Border Style="{StaticResource InputBorderStyle}" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Payment, StringFormat='Payment: {0}'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Invoice Table -->
                <Border Grid.Row="4" Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" Height="200">
                    <DataGrid x:Name="ProductsGrid"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="True"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="14"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              ItemsSource="{Binding InvoiceItems}"
              AlternatingRowBackground="#5A5A5A">

                        <!-- Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Cell Styling -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0.5"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4AA902"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#4F4F4F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A6A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Columns -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU #" Binding="{Binding SKU}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='R {0:F2}'}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='R {0:F2}'}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ================= FOOTER ================= -->
                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left comments -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                        <!-- Other Comments -->
                        
                        <Border Style="{StaticResource InputBorderStyle}"  Height="30">
                            <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" 
                                    Text="Other Comments"/>
                            
                        </Border>

                        <!-- Terms and Conditions -->
                        
                        <Border Style="{StaticResource InputBorderStyle}" Height="80">
                            <TextBox x:Name="TermsTextBox"
                  Text="Please include the quote number on your POP.&#x0a;Please note that quotes are valid for 7 days only, and prices may change.&#x0a;All orders require full payment up front before being processed.&#x0a;Upon any purchase you agree to our terms and conditions."
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Padding="8,5"
                  VerticalContentAlignment="Center"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  IsReadOnly="True"/>
                        </Border>

                        <!-- Bank Details -->
                       
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,0" Height="80">
                            <TextBox x:Name="BankDetailsTextBox"
                 Text="Adix Shooting &amp; Tactical&#x0a;FNB Business Account&#x0a;Acc: 62737653445&#x0a;Branch: 250655"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 Padding="8,5"
                 VerticalContentAlignment="Center"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <!-- SPACER -->
                    <Grid Grid.Column="1" Width="20"/>

                    <!-- Right totals -->
                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <!-- Sub Total -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="180">
                                <TextBlock Text="{Binding SubTotal, StringFormat='Sub Total: R {0:F2}'}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="8,0"/>
                            </Border>
                        </Grid>

                        <!-- Item Discounts -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="180">
                                <TextBlock Text="{Binding TotalItemDiscounts, StringFormat='Item Discounts: R {0:F2}'}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="8,0"/>
                            </Border>
                        </Grid>

                        <!-- Overall Discount -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="180">
                                <TextBlock Text="{Binding OverallDiscountAmount, StringFormat='Overall Discount: R {0:F2}'}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="8,0"/>
                            </Border>
                        </Grid>

                        <!-- Total Discount (Combined) -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="180">
                                <TextBlock Text="{Binding TotalDiscount, StringFormat='Total Discount: R {0:F2}'}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="8,0"
                       FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Grand Total -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Style="{StaticResource InputBorderStyle}" Width="180" Background="#3A3A3A">
                                <TextBlock Text="{Binding GrandTotal, StringFormat='Grand Total: R {0:F2}'}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="8,0"
                       FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Thank You Footer -->
                <TextBlock Grid.Row="8" 
                           Text="Thank You For Your Business!" 
                           FontWeight="Bold" 
                           FontSize="16"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Margin="0,20,0,10"
                           Foreground="White"/>

                <!-- Bottom Buttons -->
                <StackPanel Grid.Row="10" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Button Content="Back" Width="150" Height="40"
                            Background="Green" Foreground="White" FontWeight="Bold" Margin="5"
                            Style="{StaticResource SolidButtonStyle}"
                            Click="BackToPOS_Click"/>
                    
                    <Button Content="Save Invoice" Width="150" Height="40"
                            Background="#4AA902" Foreground="White" FontWeight="Bold" Margin="5"
                            Style="{StaticResource SolidButtonStyle}"/>
                    
                    <Button Content="Print Invoice" Width="150" Height="40"
                            Background="#2D2D2D" Foreground="White" FontWeight="Bold" Margin="5"
                            Style="{StaticResource SolidButtonStyle}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>