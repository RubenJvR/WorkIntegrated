<Page x:Class="ADIX.SupplierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"

      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SupplierPage">

    <Page.Resources>
        <!-- Header styles -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded input border -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Converters -->
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Rounded ComboBox with placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="LightGray"
                                       Margin="8,0,30,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,30,0"/>
                            <!-- Toggle button arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded input style (TextBox + ComboBox)  (Might delete)-->
        <Style x:Key="RoundedInputStyle" TargetType="Control">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <!--<local:Sidebar Grid.Column="0" Margin="0,0,10,209"/>-->

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Supplier -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <!-- Date Range -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Stock Type -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Low Stock-->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- Payment Status -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- VAT -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
               
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Supplier"/>
            </Border>

            <!-- Supplier-->
            <ComboBox Grid.Row="2"
          x:Name="Supplier"
          Style="{StaticResource RoundedComboBoxStyle}"
          Tag="Suppliers"
          SelectedIndex="-1">
            <ComboBoxItem Content="Supplier One"/>
            </ComboBox>


            <!-- Date Range -->
            <StackPanel Grid.Row="4" Orientation="Vertical">
                <!-- Main date range selector -->
                <ComboBox x:Name="DateRange"
              Style="{StaticResource RoundedComboBoxStyle}"
              Tag="Date Range"
              SelectedIndex="-1"
              SelectionChanged="DateRange_SelectionChanged">
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="Last 30 Days"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>

                <!-- Custom range pickers (hidden by default) -->
                <StackPanel x:Name="CustomDatePanel"
            Orientation="Horizontal"
            Margin="0,5,0,0"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
                    <DatePicker x:Name="StartDatePicker"
                Width="150"
                SelectedDate="{x:Static sys:DateTime.Now}"
                Margin="0,0,10,0"/>
                    
                    <TextBlock Text="to"
               VerticalAlignment="Center"
               Foreground="White"
               Margin="0,0,10,0"/>

                    <DatePicker x:Name="EndDatePicker"
                Width="150"
                SelectedDate="{x:Static sys:DateTime.Now}"/>
                </StackPanel>
            </StackPanel>


            <!-- Search by Supplier or Description -->
            <Border Grid.Row="6" Style="{StaticResource InputBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Search TextBox -->
                    <TextBox
            x:Name="SearchTextBox"
            Background="Transparent"
            BorderThickness="0"
            Foreground="White"
            Padding="8,5,8,5"
            VerticalContentAlignment="Center"
            KeyDown="SearchTextBox_KeyDown"
            TextChanged="SearchTextBox_TextChanged"/>

                    <!-- Placeholder -->
                    <TextBlock
            Text="Search by supplier or description..."
            Foreground="LightGray"
            Margin="10,0,30,0"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Visibility="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                    <!-- Autocomplete Popup -->
                    <Popup
            x:Name="AutoCompletePopup"
            PlacementTarget="{Binding ElementName=SearchTextBox}"
            Placement="Bottom"
            StaysOpen="False"
            AllowsTransparency="True"
            PopupAnimation="Fade"
            MaxHeight="250">

                        <Border
                Background="#333"
                BorderBrush="#222"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="{Binding ActualWidth, ElementName=SearchTextBox}">

                            <ListBox
                    x:Name="AutoCompleteListBox"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="AutoCompleteListBox_SelectionChanged">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="5">
                                            <TextBlock Text="{Binding SupplierName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding ItemDescription}" Foreground="LightGray" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Price: R" Foreground="LightGray" FontSize="11"/>
                                                <TextBlock Text="{Binding Price, StringFormat=F2}" Foreground="LightGray" FontSize="11" Margin="2,0,10,0"/>
                                                <TextBlock Text="Stock: " Foreground="LightGray" FontSize="11"/>
                                                <TextBlock Text="{Binding Stock}" Foreground="LightGray" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#555"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Low Stock + Payment Status (WPF-compatible, responsive) -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Low Stock Toggle (fixed width; shows ON/OFF) -->
                <ToggleButton x:Name="LowStockToggle"
                  Grid.Column="0"
                  Width="150"
                  Height="30"
                  Margin="0,0,10,0"
                  Background="#4F4F4F"
                  Foreground="White"
                  BorderBrush="Black"
                  BorderThickness="1"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#4F4F4F"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <!-- Knob -->
                                                <Ellipse x:Name="Knob"
                                             Width="20" Height="20"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             Margin="4,0"/>
                                                <!-- State text -->
                                                <TextBlock x:Name="StateText"
                                               Text="Low Stock"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Triggers to move knob and change text/color -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="Green"/>
                                                <Setter TargetName="StateText" Property="Text" Value="Low Stock ON"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="StateText" Property="Text" Value="Low Stock OFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- Payment Status ComboBox (fills remaining width) -->
                <ComboBox x:Name="PaymentStatus"
              Grid.Column="1"
              Style="{StaticResource RoundedComboBoxStyle}"
              Tag="Payment Status"
              SelectedIndex="-1"
              VerticalAlignment="Center">
                    <ComboBoxItem Content="Paid"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Overdue"/>
                </ComboBox>
            </Grid>



            <!-- Suppliers Table -->
            <Border Grid.Row="12" Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1" Height="288">
                <DataGrid x:Name="SupplierGrid"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="True"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="14"
              AlternatingRowBackground="#5A5A5A">

                    <!-- Column Header Styling -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Cell Styling -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#4AA902"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Row Styling -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#4F4F4F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A5A5A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Supplier/Consignor" Binding="{Binding Supplier}" Width="200" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="70" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="N/A">
                                            <Setter Property="Foreground" Value="LightGray"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="230" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stock Received" Binding="{Binding StockReceived}" Width="120" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stock Balance" Binding="{Binding StockBalance}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Amount Sold" Binding="{Binding AmountSold}" Width="100" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice}" Width="130" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice}" Width="180" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total Sales" Binding="{Binding TotalSales}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Profit" Binding="{Binding Profit}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaid}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total to pay" Binding="{Binding TotalToPay}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Invoice Ref" Binding="{Binding InvoiceRef}" Width="150" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="14" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10,0,0">

                <Button Content="Delete Supplier" Width="150" Height="40"
                Background="Red" Foreground="White" FontWeight="Bold" Margin="5"
                Click="DeleteSupplierButton_Click"/>

                <Button Content="Add Supplier" Width="150" Height="40"
        Background="Green" Foreground="White" FontWeight="Bold" Margin="5"
        Click="AddSupplierButton_Click"/>

                <Button Content="Edit Supplier" Width="150" Height="40"
        Background="#4F4F4F" Foreground="White" Margin="5"
        Click="EditSupplierButton_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
