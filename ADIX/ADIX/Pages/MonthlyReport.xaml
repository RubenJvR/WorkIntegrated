<Page x:Class="ADIX.MonthlyReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:ADIX"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1000"
      Title="Monthly Report">

    <Page.Resources>
        <!-- Reuse styles from Sales page -->
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4AA902"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Enhanced ComboBox Style with Dynamic Placeholder -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0,30,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"/>

                            <!-- Dynamic Placeholder Text - Only shows when no item selected -->
                            <TextBlock x:Name="PlaceholderText"
                               Text="{TemplateBinding Tag}"
                               Foreground="LightGray"
                               Margin="8,0,30,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Content Presenter - Shows selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      VerticalAlignment="Center"
                                      Margin="8,0,30,0">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                            </ContentPresenter>

                            <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  ClickMode="Press"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Width="20">
                                <Path Fill="White" Data="M 0 0 L 4 4 L 8 0 Z" Stretch="Uniform"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Border" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Summary Border Style -->
        <Style x:Key="SummaryBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Summary Text Style -->
        <Style x:Key="SummaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Summary Header Style -->
        <Style x:Key="SummaryHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SummaryTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#4AA902"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Supplier Button Style -->
        <Style x:Key="SupplierButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#4F4F4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Background="#878787">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="10"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Month Selector -->
                <RowDefinition Height="8"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Report Table Header -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="15"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Summary Section -->
                <RowDefinition Height="15"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Supplier Stock Section -->
                <RowDefinition Height="10"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
                <TextBlock x:Name="ReportHeader" Style="{StaticResource HeaderTextStyle}" Text="Monthly Report"/>
            </Border>

            <!-- Month and Year Selectors -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <!-- Month Selector with Dynamic Placeholder -->
                <ComboBox x:Name="MonthSelector"
              Style="{StaticResource RoundedComboBoxStyle}"
              Tag="Filter by Month"
              SelectedIndex="-1"
              SelectionChanged="MonthSelector_SelectionChanged">
                    <ComboBoxItem Content="January"/>
                    <ComboBoxItem Content="February"/>
                    <ComboBoxItem Content="March"/>
                    <ComboBoxItem Content="April"/>
                    <ComboBoxItem Content="May"/>
                    <ComboBoxItem Content="June"/>
                    <ComboBoxItem Content="July"/>
                    <ComboBoxItem Content="August"/>
                    <ComboBoxItem Content="September"/>
                    <ComboBoxItem Content="October"/>
                    <ComboBoxItem Content="November"/>
                    <ComboBoxItem Content="December"/>
                </ComboBox>

                <!-- Year Selector with Dynamic Placeholder -->
                <ComboBox x:Name="YearSelector"
              Style="{StaticResource RoundedComboBoxStyle}"
              Tag="Filter by Year"
              SelectedIndex="-1"
              Margin="0,5,0,0"
              SelectionChanged="YearSelector_SelectionChanged">
                    <!-- Years will be populated in code-behind -->
                </ComboBox>
            </StackPanel>

            <!-- Report Table Header -->
            <Border Grid.Row="4" Style="{StaticResource HeaderBorderStyle}">
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Monthly Transactions"/>
            </Border>

            <!-- Monthly Transactions Table -->
            <Border Grid.Row="5" Margin="0,10,0,10" Background="#4F4F4F" BorderBrush="Black" BorderThickness="1">
                <DataGrid x:Name="MonthlyReportGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#4F4F4F"
              Foreground="White"
              GridLinesVisibility="All"
              BorderBrush="Black"
              BorderThickness="1"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              RowHeight="35"
              ColumnHeaderHeight="40"
              FontSize="14"
              AlternatingRowBackground="#5A5A5A">

                    <!-- Column Header Styling -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Cell Styling -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#4AA902"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Row Styling -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#4F4F4F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6A6A6A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5A5A5A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sales Staff" Binding="{Binding SalesStaff}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat='R {0:F2}'}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Purchase Amount" Binding="{Binding PurchaseAmount, StringFormat='R {0:F2}'}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="140" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNumber}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Summary Section -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monthly Turnover -->
                <Border Grid.Column="0" Style="{StaticResource SummaryBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="Monthly Turnover"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.CardAmount, StringFormat='Card: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.CashAmount, StringFormat='Cash: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.EFTAmount, StringFormat='EFT: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.ReturnAmount, StringFormat='Return: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.CreditAmount, StringFormat='Credit: R {0:F2}'}"/>
                        <Border Background="#2D2D2D" Height="1" Margin="0,5,0,5"/>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="{Binding CurrentReport.TotalTurnover, StringFormat='Total: R {0:F2}'}"/>
                    </StackPanel>
                </Border>

                <!-- Monthly Expenses -->
                <Border Grid.Column="1" Style="{StaticResource SummaryBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="Monthly Expenses"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.RentExpense, StringFormat='Rent: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.UtilitiesExpense, StringFormat='Utilities: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.SalaryExpense, StringFormat='Salaries: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.OtherExpense, StringFormat='Other: R {0:F2}'}"/>
                        <Border Background="#2D2D2D" Height="1" Margin="0,5,0,5"/>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="{Binding CurrentReport.TotalExpenses, StringFormat='Total: R {0:F2}'}"/>
                    </StackPanel>
                </Border>

                <!-- Profit & Loss -->
                <Border Grid.Column="2" Style="{StaticResource SummaryBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="Profit &amp; Loss"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.MonthlyCostOfBusiness, StringFormat='Cost of Business: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.GrossProfit, StringFormat='Gross Profit: R {0:F2}'}"/>
                        <TextBlock Style="{StaticResource SummaryTextStyle}" Text="{Binding CurrentReport.NetProfit, StringFormat='Net Profit: R {0:F2}'}"/>
                        <Border Background="#2D2D2D" Height="1" Margin="0,5,0,5"/>
                        <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="{Binding CurrentReport.ProfitMargin, StringFormat='Profit Margin: {0:F2}%'}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Supplier Stock Section -->
            <Border Grid.Row="9" Style="{StaticResource SummaryBorderStyle}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource SummaryHeaderStyle}" Text="Supplier Stock Reports"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
                        <ComboBox x:Name="SupplierComboBox"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Width="250"
                      VerticalAlignment="Center"
                      Tag="Select Supplier"
                      SelectedIndex="-1"/>

                        <Button x:Name="SaveSupplierReport"
                    Content="Save Supplier Report"
                    Style="{StaticResource SupplierButtonStyle}"
                    Click="SaveSupplierReport_Click"
                    Margin="20,0,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SummaryTextStyle}" 
                   Text="Generate individual supplier reports showing current stock levels and monthly sales performance."
                   FontStyle="Italic"
                   TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="ExportPdf" 
                        Content="Export as PDF" 
                        Style="{StaticResource SupplierButtonStyle}" 
                        Width="150"
                        Click="ExportPdf_Click"
                        Margin="20,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>