<Window x:Class="ADIX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADIX"
        mc:Ignorable="d"
        Title="ADIX - Inventory Management" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar always here -->
            <ColumnDefinition Width="*"/>
            <!-- Content goes here -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar - ALWAYS VISIBLE -->
        <local:Sidebar x:Name="SidebarControl" Grid.Column="0" Loaded="SidebarControl_Loaded"/>

        <!-- Frame - Shows different pages in the RIGHT column only -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>