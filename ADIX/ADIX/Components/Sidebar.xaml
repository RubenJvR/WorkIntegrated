<UserControl x:Class="ADIX.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADIX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="200"/>
            <ColumnDefinition Width="8"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="DarkSeaGreen" Grid.Column="0">
            <Button Content="☰" Click="ToggleBtn_Click"/>
            <Button Content="Dashboard" Click="Dashboard_Click"/>
            <Button Content="POS" Click="Pos_Click"/>
            <Button Content="Inventory" Click="Inventory_Click"/>
            <Button Content="Products" Click="Product_Click"/>
            <Button Content="Supplier" Click="Supplier_Click"/>
            <Button Content="Finance" Click="Finance_Click"/>
            <Button Content="Sales" Click="Sales_Click"/>
            <Button Content="Consignment" Click="Consignment_Click"/>
            
        </StackPanel>

        <ContentPresenter Grid.Column="1" x:Name="ContentArea"/>

    </Grid>
</UserControl>
